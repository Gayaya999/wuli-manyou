DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash

# 上线时改成真实域名；多个值用逗号分隔。
WULI_ALLOWED_ORIGINS=https://example.com
WULI_ALLOWED_HOSTS=example.com,www.example.com,127.0.0.1,localhost
WULI_TRUST_PROXY_HEADERS=1

# 保守默认额度，部署时按预算调整，绝不写进前端。
WULI_RATE_PER_MINUTE=10
WULI_IP_DAILY_LIMIT=60
WULI_GLOBAL_DAILY_LIMIT=500
WULI_AI_TIMEOUT_SECONDS=20
WULI_AI_MAX_TOKENS=500
WULI_AI_MAX_OUTPUT_CHARS=2400
